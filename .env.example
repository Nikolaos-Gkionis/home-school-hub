# Copy to ".env" in the project root and set values locally. ".env" is gitignored.
# See README for Oak sync and https://open-api.thenational.academy/docs/about-oaks-api/api-keys

OAK_API_TOKEN=
# If Oak gives a non-Bearer Authorization header, set the full value instead:
# OAK_API_AUTH_HEADER=

# --- Email (production on DigitalOcean: use Brevo API — SMTP ports 25/465/587 are blocked) ---

# Brevo transactional API (HTTPS). Create key: https://app.brevo.com → SMTP & API → API keys
BREVO_API_KEY=

# Sender for all mailers — must match a verified sender in Brevo (Senders & IP → Domains / Single sender).
# Use single quotes if the value contains spaces or < > (required for `.kamal/secrets` sourcing `.env`).
MAILER_FROM='Home School Hub <you@your-verified-domain.com>'

# Optional HTTP timeout (seconds) for Brevo requests (defaults in production.rb if unset).
# BREVO_HTTP_TIMEOUT=30

# Optional fallback: SMTP (only if your host allows outbound 587 — not on default DigitalOcean droplets)
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_DOMAIN=example.com
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true
# SMTP_OPEN_TIMEOUT=30
# SMTP_READ_TIMEOUT=60

# Production mailer links (local dev uses localhost:3000 in development.rb)
# MAILER_HOST=homeschool.example.com
