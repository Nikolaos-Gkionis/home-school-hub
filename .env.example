# Copy to ".env" in the project root and set values locally. ".env" is gitignored.
# See README for Oak sync and https://open-api.thenational.academy/docs/about-oaks-api/api-keys

OAK_API_TOKEN=
# If Oak gives a non-Bearer Authorization header, set the full value instead:
# OAK_API_AUTH_HEADER=

# SMTP (simple Gmail setup)
# 1) Enable 2FA on your Google account
# 2) Create an App Password
# 3) Put your Gmail address + app password below
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_DOMAIN=gmail.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# Email sender shown in invites
MAILER_FROM=no-reply@homeschoolhub.local
