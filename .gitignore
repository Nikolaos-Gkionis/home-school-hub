# See https://help.github.com/articles/ignoring-files for more about ignoring files.

/.bundle
/.env*
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep
/public/assets
/config/*.key
/app/assets/builds/*
!/app/assets/builds/.keep

# Local gem mirror (do not commit)
/.gem/

.DS_Store
