# See https://help.github.com/articles/ignoring-files for more about ignoring files.

/.bundle

.kamal/secrets
# Local secrets — never commit API tokens, passwords, or real keys
# Matches .env, .env.local, .env.development.local, etc. (any directory)
.env
.env.*
!.env.example

/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep
/public/assets
/config/*.key
/app/assets/builds/*
!/app/assets/builds/.keep

# Local gem mirror (do not commit)
/.gem/

.DS_Store
