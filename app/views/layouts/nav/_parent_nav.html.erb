<% dash = request.path == parent_dashboard_path %>
<% fam = request.path == parent_family_path %>
<%= link_to parent_dashboard_path, class: "sidebar-nav-link flex items-center gap-2 rounded-md px-2 py-1.5 hover:bg-white/5 #{dash ? "border-l-4 border-[var(--color-accent)] bg-white/5 font-medium" : ""}" do %>
  <i class="fa-solid fa-house fa-fw shrink-0 text-[var(--color-accent)] opacity-90" aria-hidden="true"></i>
  <span class="sidebar-nav-label truncate">Dashboard</span>
<% end %>
<%= link_to parent_family_path, class: "sidebar-nav-link flex items-center gap-2 rounded-md px-2 py-1.5 hover:bg-white/5 #{fam ? "border-l-4 border-[var(--color-accent)] bg-white/5 font-medium" : ""}" do %>
  <i class="fa-solid fa-people-roof fa-fw shrink-0 text-[var(--color-accent)] opacity-90" aria-hidden="true"></i>
  <span class="sidebar-nav-label truncate">Sent invites</span>
<% end %>
<%= link_to new_invitation_path, class: "sidebar-nav-link flex items-center gap-2 rounded-md px-2 py-1.5 text-[11px] hover:bg-white/5" do %>
  <i class="fa-solid fa-user-plus fa-fw shrink-0 text-[var(--color-text-muted)]" aria-hidden="true"></i>
  <span class="sidebar-nav-label truncate">Invite child</span>
<% end %>
