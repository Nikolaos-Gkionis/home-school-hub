<% today = request.path == child_dashboard_path && params[:overview].blank? && params[:view] != "week" %>
<% timetable_week = request.path == child_dashboard_path && params[:view] == "week" %>
<% month = request.path == child_dashboard_path && params[:overview] == "month" %>
<% week = request.path == child_dashboard_path && params[:overview] == "week" %>
<% profile = request.path == child_profile_path %>
<%= link_to child_dashboard_path(view: "day"), class: "sidebar-nav-link #{today ? "is-active" : ""}" do %>
  <i class="fa-solid fa-sun fa-fw shrink-0 text-[var(--color-accent)]" aria-hidden="true"></i>
  <span class="sidebar-nav-label truncate">Day</span>
<% end %>
<%= link_to child_dashboard_path(view: "week"), class: "sidebar-nav-link #{timetable_week ? "is-active" : ""}" do %>
  <i class="fa-solid fa-calendar-week fa-fw shrink-0 text-[var(--color-accent)]" aria-hidden="true"></i>
  <span class="sidebar-nav-label truncate">Week</span>
<% end %>
<%= link_to child_dashboard_path(overview: "week"), class: "sidebar-nav-link #{week ? "is-active" : ""}" do %>
  <i class="fa-solid fa-calendar-week fa-fw shrink-0 text-[var(--color-accent)]" aria-hidden="true"></i>
  <span class="sidebar-nav-label truncate">This week</span>
<% end %>
<%= link_to child_dashboard_path(overview: "month"), class: "sidebar-nav-link #{month ? "is-active" : ""}" do %>
  <i class="fa-solid fa-calendar-day fa-fw shrink-0 text-[var(--color-accent)]" aria-hidden="true"></i>
  <span class="sidebar-nav-label truncate">This month</span>
<% end %>
<%= link_to child_profile_path, class: "sidebar-nav-link #{profile ? "is-active" : ""}" do %>
  <i class="fa-solid fa-user fa-fw shrink-0 text-[var(--color-accent)]" aria-hidden="true"></i>
  <span class="sidebar-nav-label truncate">My profile</span>
<% end %>
