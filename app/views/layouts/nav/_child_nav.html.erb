<% dash = request.path == child_dashboard_path %>
<% profile = request.path == child_profile_path %>
<%= link_to child_dashboard_path, class: "sidebar-nav-link flex items-center gap-2 rounded-md px-2 py-1.5 hover:bg-white/5 #{dash ? "border-l-4 border-[var(--color-accent)] bg-white/5 font-medium" : ""}" do %>
  <i class="fa-solid fa-house fa-fw shrink-0 text-[var(--color-accent)] opacity-90" aria-hidden="true"></i>
  <span class="sidebar-nav-label truncate">My learning</span>
<% end %>
<%= link_to child_profile_path, class: "sidebar-nav-link flex items-center gap-2 rounded-md px-2 py-1.5 hover:bg-white/5 #{profile ? "border-l-4 border-[var(--color-accent)] bg-white/5 font-medium" : ""}" do %>
  <i class="fa-solid fa-user fa-fw shrink-0 text-[var(--color-accent)] opacity-90" aria-hidden="true"></i>
  <span class="sidebar-nav-label truncate">My profile</span>
<% end %>
