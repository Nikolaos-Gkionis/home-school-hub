<!DOCTYPE html>
<html lang="en" class="h-dvh overflow-hidden">
  <head>
    <title><%= content_for(:title) || "HomeSchool Hub" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= render "shared/web_app_head" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="<%= google_fonts_href %>" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="<%= ThemeManager.body_class_for %> min-h-dvh bg-[var(--color-bg)] font-sans text-[var(--color-text)] antialiased">
    <%= render "shared/flash_modal" %>
    <%= render "shared/confirm_dialog" %>

    <main id="main-content" class="flex min-h-dvh items-center justify-center p-4">
      <div class="hub-card w-full max-w-md p-8">
        <%= link_to root_path, class: "font-display text-2xl font-semibold tracking-tight text-[var(--color-accent)]" do %>
          <i class="fa-solid fa-graduation-cap mr-1.5" aria-hidden="true"></i>
          HomeSchool Hub
        <% end %>
        <%= yield %>
      </div>
    </main>
  </body>
</html>
