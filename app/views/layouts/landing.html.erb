<!DOCTYPE html>
<html lang="en" class="min-h-full">
  <head>
    <title><%= content_for(:title) || "HomeSchool Hub" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="<%= google_fonts_href %>" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="<%= ThemeManager.body_class_for %> min-h-full bg-[var(--color-bg)] font-sans text-[var(--color-text)] antialiased">
    <%= render "shared/flash_modal" %>
    <%= render "shared/confirm_dialog" %>

    <div class="flex min-h-full flex-col">
      <header class="mx-auto flex w-full max-w-5xl items-center justify-between px-4 py-5 sm:px-6">
        <%= link_to root_path, class: "font-display text-xl font-semibold text-[var(--color-accent)]" do %>
          <i class="fa-solid fa-graduation-cap mr-1.5" aria-hidden="true"></i>
          HomeSchool Hub
        <% end %>
        <div class="flex items-center gap-2">
          <%= link_to "Sign in", new_user_session_path, class: "hub-btn hub-btn-ghost hub-btn-sm" %>
          <%= link_to "Sign up", new_user_registration_path, class: "hub-btn hub-btn-primary hub-btn-sm" %>
        </div>
      </header>
      <main id="main-content" class="mx-auto w-full max-w-3xl flex-1 px-4 py-6 sm:px-6">
        <%= yield %>
      </main>
    </div>
  </body>
</html>
