<% content_for :title, "Choose school years — HomeSchool Hub" %>

<div class="mx-auto max-w-lg space-y-6 py-4">
  <div>
    <h1 class="font-display text-xl font-bold text-[var(--color-accent)] sm:text-2xl">Welcome</h1>
    <p class="mt-2 text-sm text-[var(--color-text-muted)]">
      Pick every school year you need. You can add more later from the sidebar.
    </p>
  </div>

  <%= form_with url: onboarding_path, method: :post, class: "space-y-6", data: { turbo: true } do %>
    <fieldset class="space-y-4">
      <legend class="text-xs font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">School years</legend>
      <% @phases.each do |phase| %>
        <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-3">
          <p class="mb-2 text-xs font-semibold text-[var(--color-text)]"><%= phase[:label] %></p>
          <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
            <% phase[:years].each do |y| %>
              <label class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-xs hover:bg-white/5">
                <%= check_box_tag "year_group_keys[]", y[:key], false,
                    class: "rounded border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-accent)]" %>
                <span><%= y[:label] %></span>
              </label>
            <% end %>
          </div>
        </div>
      <% end %>
    </fieldset>

    <%= submit_tag "Continue to hub",
        class: "w-full cursor-pointer rounded-md bg-[var(--color-accent)] px-4 py-2.5 text-sm font-semibold text-[var(--color-bg)] hover:brightness-110" %>
  <% end %>
</div>
