<div id="lesson_status_<%= lesson.id %>" class="flex items-center gap-2">
  <% if user.completed?(lesson) %>
    <span class="rounded-full bg-[var(--color-accent)]/20 px-2.5 py-1 text-xs font-medium text-[var(--color-accent)] sm:text-sm">Done</span>
  <% else %>
    <%= button_to "Complete",
                  lesson_completions_path,
                  params: { lesson_id: lesson.id },
                  method: :post,
                  class: "rounded-lg bg-[var(--color-accent)] px-3 py-1.5 text-xs font-semibold text-[var(--color-bg)] hover:opacity-90 sm:px-3.5 sm:text-sm",
                  data: { turbo: true, turbo_stream: true } %>
  <% end %>
</div>
