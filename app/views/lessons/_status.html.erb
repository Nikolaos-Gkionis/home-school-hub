<div id="lesson_status_<%= lesson.id %>" class="flex items-center gap-2">
  <% if user.completed?(lesson) %>
    <span class="rounded-full bg-[var(--color-hover)] px-3 py-1.5 text-sm font-semibold text-[var(--color-accent)]">Done</span>
  <% else %>
    <%= button_to "Complete",
                  lesson_completions_path,
                  params: { lesson_id: lesson.id },
                  method: :post,
                  class: "hub-btn hub-btn-primary hub-btn-sm",
                  data: { turbo: true, turbo_stream: true } %>
  <% end %>
</div>
