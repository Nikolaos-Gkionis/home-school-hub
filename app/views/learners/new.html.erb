<% content_for :title, "Add a school year — HomeSchool Hub" %>

<div class="mx-auto max-w-lg space-y-6 py-4">
  <h1 class="font-display text-xl font-bold text-[var(--color-accent)] sm:text-2xl">Add a school year</h1>

  <div class="space-y-4">
    <% @phases.each do |phase| %>
      <% available = phase[:years].reject { |y| @taken.include?(y[:key]) } %>
      <% next if available.empty? %>

      <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-3">
        <p class="mb-2 text-xs font-semibold text-[var(--color-text)]"><%= phase[:label] %></p>
        <div class="flex flex-col gap-1">
          <% available.each do |y| %>
            <%= button_to y[:label],
                learners_path,
                method: :post,
                params: { year_group_key: y[:key] },
                class: "w-full cursor-pointer rounded-md border border-[var(--color-border)] px-3 py-2 text-left text-xs hover:bg-white/5" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%= link_to "Back to hub", parent_dashboard_path, class: "inline-block text-xs text-[var(--color-accent)] hover:underline" %>
</div>
