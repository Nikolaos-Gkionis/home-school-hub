<% content_for :title, "Add a school year — HomeSchool Hub" %>

<div class="mx-auto max-w-lg space-y-6 py-4">
  <%= render "shared/hub_page_header",
      title: "Add a school year",
      description: "Pick another year slot for this account." %>

  <div class="space-y-4">
    <% @phases.each do |phase| %>
      <% available = phase[:years].reject { |y| @taken.include?(y[:key]) } %>
      <% next if available.empty? %>

      <%= render layout: "shared/hub_card", locals: { title: phase[:label] } do %>
        <div class="flex flex-col gap-2">
          <% available.each do |y| %>
            <%= button_to y[:label],
                learners_path,
                method: :post,
                params: { year_group_key: y[:key] },
                class: "hub-btn hub-btn-secondary w-full justify-start" %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <%= link_to "Back to hub", parent_dashboard_path, class: "hub-btn hub-btn-ghost" %>
</div>
