<% content_for :title, "Sign in — HomeSchool Hub" %>

<p class="mt-4 text-sm text-[var(--color-text-muted)]">Welcome back</p>
<h1 class="mt-1 font-display text-2xl font-semibold text-[var(--color-text)]">Sign in</h1>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-6 space-y-4" }) do |f| %>
  <div>
    <%= f.label :email, class: "block text-xs font-medium text-[var(--color-text-muted)]" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email",
        class: "mt-1.5 block w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] px-3 py-2.5 text-[var(--color-text)] focus:border-[var(--color-accent)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/35" %>
  </div>

  <div>
    <%= f.label :password, class: "block text-xs font-medium text-[var(--color-text-muted)]" %>
    <%= f.password_field :password, autocomplete: "current-password",
        class: "mt-1.5 block w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] px-3 py-2.5 text-[var(--color-text)] focus:border-[var(--color-accent)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/35" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <label class="flex items-center gap-2 text-xs text-[var(--color-text-muted)]">
      <%= f.check_box :remember_me, class: "rounded border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-accent)]" %>
      <%= f.label :remember_me %>
    </label>
  <% end %>

  <%= f.submit "Sign in",
      class: "w-full cursor-pointer rounded-lg bg-[var(--color-accent)] py-3 text-sm font-semibold text-[var(--color-bg)] hover:brightness-110" %>
<% end %>

<div class="mt-6 text-center text-sm text-[var(--color-text-muted)]">
  <%= render "devise/shared/links" %>
</div>
