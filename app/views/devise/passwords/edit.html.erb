<% content_for :title, "Change password — HomeSchool Hub" %>

<p class="mt-4 text-sm text-[var(--color-text-muted)]">Choose a new password</p>
<h1 class="mt-1 font-display text-2xl font-semibold text-[var(--color-text)]">Change your password</h1>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "mt-6 space-y-4" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div>
    <%= f.label :password, "New password", class: "hub-label" %>
    <% if @minimum_password_length %>
      <p class="mb-1 text-xs text-[var(--color-text-muted)]"><%= @minimum_password_length %> characters minimum</p>
    <% end %>
    <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "hub-input" %>
  </div>

  <div>
    <%= f.label :password_confirmation, "Confirm new password", class: "hub-label" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "hub-input" %>
  </div>

  <%= f.submit "Change my password", class: "hub-btn hub-btn-primary w-full" %>
<% end %>

<div class="mt-6 text-center text-sm text-[var(--color-text-muted)]">
  <%= render "devise/shared/links" %>
</div>
