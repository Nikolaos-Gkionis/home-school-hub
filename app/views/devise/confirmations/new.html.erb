<% content_for :title, "Resend confirmation — HomeSchool Hub" %>

<p class="mt-4 text-sm text-[var(--color-text-muted)]">We'll send a new confirmation email</p>
<h1 class="mt-1 font-display text-2xl font-semibold text-[var(--color-text)]">Resend confirmation</h1>

<%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post, class: "mt-6 space-y-4" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div>
    <%= f.label :email, class: "hub-label" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email",
        value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email),
        class: "hub-input" %>
  </div>

  <%= f.submit "Resend confirmation instructions", class: "hub-btn hub-btn-primary w-full" %>
<% end %>

<div class="mt-6 text-center text-sm text-[var(--color-text-muted)]">
  <%= render "devise/shared/links" %>
</div>
