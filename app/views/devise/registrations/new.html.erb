<% content_for :title, "Sign up — HomeSchool Hub" %>

<p class="mt-4 text-sm text-[var(--color-text-muted)]">Create your account</p>
<h1 class="mt-1 font-display text-2xl font-semibold text-[var(--color-text)]">Sign up</h1>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "mt-6 space-y-4" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <% if params[:invite_token].present? %>
    <%= hidden_field_tag "user[invite_token]", params[:invite_token] %>
    <p class="rounded-2xl border border-[var(--color-accent)]/40 bg-[var(--color-hover)] px-3 py-2 text-sm text-[var(--color-text)]">
      You’re completing an invitation. Use the same email the parent invited.
    </p>
  <% end %>

  <div>
    <%= f.label :email, class: "hub-label" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", value: params.dig(:user, :email), class: "hub-input" %>
  </div>

  <div>
    <%= f.label :password, class: "hub-label" %>
    <% if @minimum_password_length %>
      <span class="text-xs text-[var(--color-text-muted)]">(<%= @minimum_password_length %> characters minimum)</span>
    <% end %>
    <%= f.password_field :password, autocomplete: "new-password", class: "hub-input" %>
  </div>

  <div>
    <%= f.label :password_confirmation, class: "hub-label" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "hub-input" %>
  </div>

  <%= f.submit "Create account", class: "hub-btn hub-btn-primary w-full" %>
<% end %>

<div class="mt-6 text-center text-sm text-[var(--color-text-muted)]">
  <%= render "devise/shared/links" %>
</div>

<div class="mt-8">
  <%= render "shared/ogl_footer" %>
</div>
