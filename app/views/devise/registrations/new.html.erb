<% content_for :title, "Sign up — HomeSchool Hub" %>

<p class="mt-4 text-sm text-[var(--color-text-muted)]">Create your account</p>
<h1 class="mt-1 font-display text-2xl font-semibold text-[var(--color-text)]">Sign up</h1>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "mt-6 space-y-4" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <% if params[:invite_token].present? %>
    <%= hidden_field_tag "user[invite_token]", params[:invite_token] %>
    <p class="rounded-lg border border-[var(--color-accent)]/40 bg-[var(--color-accent)]/10 px-3 py-2 text-xs text-[var(--color-text)]">
      You’re completing an invitation. Use the same email the parent invited.
    </p>
  <% end %>

  <div>
    <%= f.label :email, class: "block text-xs font-medium text-[var(--color-text-muted)]" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", value: params.dig(:user, :email),
        class: "mt-1.5 block w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] px-3 py-2.5 text-[var(--color-text)] focus:border-[var(--color-accent)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/35" %>
  </div>

  <div>
    <%= f.label :password, class: "block text-xs font-medium text-[var(--color-text-muted)]" %>
    <% if @minimum_password_length %>
      <span class="text-[10px] text-[var(--color-text-muted)]">(<%= @minimum_password_length %> characters minimum)</span>
    <% end %>
    <%= f.password_field :password, autocomplete: "new-password",
        class: "mt-1.5 block w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] px-3 py-2.5 text-[var(--color-text)] focus:border-[var(--color-accent)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/35" %>
  </div>

  <div>
    <%= f.label :password_confirmation, class: "block text-xs font-medium text-[var(--color-text-muted)]" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password",
        class: "mt-1.5 block w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] px-3 py-2.5 text-[var(--color-text)] focus:border-[var(--color-accent)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/35" %>
  </div>

  <%= f.submit "Create account",
      class: "w-full cursor-pointer rounded-lg bg-[var(--color-accent)] py-3 text-sm font-semibold text-[var(--color-bg)] hover:brightness-110" %>
<% end %>

<div class="mt-6 text-center text-sm text-[var(--color-text-muted)]">
  <%= render "devise/shared/links" %>
</div>
