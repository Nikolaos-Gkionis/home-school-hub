<% content_for :title, "Edit account — HomeSchool Hub" %>

<div class="mx-auto w-full max-w-xl space-y-6 pb-8">
  <%= render "shared/hub_page_header",
      kicker: "Account",
      title: "Edit login details",
      description: "Update your email or password. You’ll need your current password to save changes." %>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "hub-card space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: "hub-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "hub-input" %>
    </div>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <p class="text-sm text-[var(--color-text-muted)]">Currently waiting confirmation for: <%= resource.unconfirmed_email %></p>
    <% end %>

    <div>
      <%= f.label :password, class: "hub-label" %>
      <p class="mb-1 text-xs text-[var(--color-text-muted)]">Leave blank if you don't want to change it.</p>
      <%= f.password_field :password, autocomplete: "new-password", class: "hub-input" %>
      <% if @minimum_password_length %>
        <p class="mt-1 text-xs text-[var(--color-text-muted)]"><%= @minimum_password_length %> characters minimum</p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, class: "hub-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "hub-input" %>
    </div>

    <div>
      <%= f.label :current_password, class: "hub-label" %>
      <p class="mb-1 text-xs text-[var(--color-text-muted)]">We need your current password to confirm your changes.</p>
      <%= f.password_field :current_password, autocomplete: "current-password", class: "hub-input" %>
    </div>

    <%= f.submit "Update", class: "hub-btn hub-btn-primary" %>
  <% end %>

  <section class="hub-card">
    <h2 class="font-display text-lg font-semibold text-[var(--color-text)]">Cancel my account</h2>
    <p class="mt-2 text-sm text-[var(--color-text-muted)]">This removes your login from HomeSchool Hub.</p>
    <%= button_to "Cancel my account", registration_path(resource_name),
        data: { turbo_confirm: "Are you sure you want to cancel your account?" },
        method: :delete,
        class: "hub-btn hub-btn-danger hub-btn-sm mt-4" %>
  </section>
</div>
