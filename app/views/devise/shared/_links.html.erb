<%- if controller_name != "sessions" %>
  <p><%= link_to "Log in", new_session_path(resource_name), class: "font-medium text-[var(--color-accent)] hover:underline" %></p>
<% end %>

<%- if devise_mapping.registerable? && controller_name != "registrations" %>
  <p><%= link_to "Need an account? Sign up", new_registration_path(resource_name), class: "font-medium text-[var(--color-accent)] hover:underline" %></p>
<% end %>

<%- if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
  <p><%= link_to "Forgot your password?", new_password_path(resource_name), class: "text-[var(--color-text-muted)] hover:underline" %></p>
<% end %>
