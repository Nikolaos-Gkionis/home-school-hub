<% content_for :title, "My profile — HomeSchool Hub" %>

<div class="mx-auto w-full max-w-3xl space-y-6 pb-8">
  <%= render "shared/hub_page_header",
      kicker: "Child",
      title: "My profile",
      description: "Your account and progress summary." %>

  <section class="hub-card">
    <h2 class="font-display text-lg font-semibold text-[var(--color-text)]">Account</h2>
    <p class="mt-2 text-sm text-[var(--color-text-muted)]">
      Signed in as <strong class="text-[var(--color-text)]"><%= current_user.email %></strong>.
      <% if @parent.present? %>
        Parent account: <strong class="text-[var(--color-text)]"><%= @parent.email %></strong>.
      <% end %>
    </p>
    <%= link_to "Edit login details", edit_user_registration_path, class: "mt-3 inline-block text-sm font-semibold text-[var(--color-accent)] hover:underline" %>
  </section>

  <section class="hub-card">
    <h2 class="font-display text-lg font-semibold text-[var(--color-text)]">School year</h2>
    <p class="mt-1 text-sm text-[var(--color-text-muted)]">
      This chooses which lessons appear in <strong class="text-[var(--color-text)]">My learning</strong>.
    </p>
    <%= form_with url: child_profile_path, method: :patch, class: "mt-4 space-y-3" do %>
      <div>
        <%= label_tag :year_group_key, "School year", class: "hub-label" %>
        <%= select_tag :year_group_key,
            options_for_select(Curriculum::YearGroups.select_options, @year_group_key),
            class: "hub-select max-w-xs" %>
      </div>
      <%= submit_tag "Switch year", class: "hub-btn hub-btn-primary" %>
    <% end %>
  </section>

  <section class="hub-card">
    <h2 class="font-display text-lg font-semibold text-[var(--color-text)]">My progress</h2>
    <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <%= render "shared/hub_metric", label: "Lessons completed", value: @metrics[:lessons_completed] %>
      <%= render "shared/hub_metric", label: "Sections viewed", value: @metrics[:sections_explored] %>
      <%= render "shared/hub_metric", label: "Quiz attempts", value: @metrics[:quiz_attempts] %>
      <%= render "shared/hub_metric", label: "Time (min)", value: @metrics[:time_minutes] %>
    </div>
  </section>
</div>
