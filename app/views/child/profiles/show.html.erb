<% content_for :title, "My profile — HomeSchool Hub" %>

<div class="mx-auto w-full max-w-3xl space-y-6 pb-8">
  <%= render "shared/hub_page_header",
      kicker: "Child",
      title: "My profile",
      description: "Your account and progress summary." %>

  <section class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]/60 p-4 shadow-sm">
    <h2 class="font-display text-sm font-semibold text-[var(--color-text)]">Account</h2>
    <p class="mt-2 text-sm text-[var(--color-text-muted)]">
      Signed in as <strong class="text-[var(--color-text)]"><%= current_user.email %></strong>.
      <% if @parent.present? %>
        Parent account: <strong class="text-[var(--color-text)]"><%= @parent.email %></strong>.
      <% end %>
    </p>
    <%= link_to "Edit login details", edit_user_registration_path, class: "mt-3 inline-block text-sm text-[var(--color-accent)] hover:underline" %>
  </section>

  <section class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]/60 p-4 shadow-sm">
    <h2 class="font-display text-sm font-semibold text-[var(--color-text)]">My progress</h2>
    <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="text-[10px] font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">Lessons completed</p>
        <p class="mt-1 text-xl font-semibold text-[var(--color-accent)]"><%= @metrics[:lessons_completed] %></p>
      </div>
      <div>
        <p class="text-[10px] font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">Sections viewed</p>
        <p class="mt-1 text-xl font-semibold text-[var(--color-accent)]"><%= @metrics[:sections_explored] %></p>
      </div>
      <div>
        <p class="text-[10px] font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">Quiz attempts</p>
        <p class="mt-1 text-xl font-semibold text-[var(--color-accent)]"><%= @metrics[:quiz_attempts] %></p>
      </div>
      <div>
        <p class="text-[10px] font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">Time (min)</p>
        <p class="mt-1 text-xl font-semibold text-[var(--color-accent)]"><%= @metrics[:time_minutes] %></p>
      </div>
    </div>
  </section>
</div>
