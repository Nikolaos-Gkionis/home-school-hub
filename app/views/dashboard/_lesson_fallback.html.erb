<%# locals: lesson: %>
<div class="flex min-h-0 flex-1 flex-col gap-4 overflow-y-auto rounded-xl border border-dashed border-[var(--color-border)] bg-[var(--color-surface)]/30 p-4 sm:p-6">
  <div class="rounded-xl bg-[var(--color-accent)]/10 px-4 py-3 text-sm text-[var(--color-text)]">
    <p class="font-semibold">Lesson content is not loaded in the hub yet</p>
    <p class="mt-2 text-[var(--color-text-muted)]">
      We don’t embed Oak’s full site in an iframe. For the full on-hub experience, set <code class="rounded bg-black/25 px-1 text-xs">OAK_API_TOKEN</code> and run
      <code class="rounded bg-black/25 px-1 text-xs">bin/rails curriculum:oak_sync</code> so lessons include API data (OGL).
    </p>
  </div>
  <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]/50 p-4">
    <h2 class="font-display text-sm font-semibold text-[var(--color-text)]"><%= lesson.title %></h2>
    <p class="mt-1 text-xs text-[var(--color-text-muted)]"><%= lesson.subject %> · <%= lesson.unit %></p>
    <div class="mt-4 flex flex-wrap gap-2">
      <%= link_to "Open this lesson on Oak National Academy",
            lesson.oak_pupil_lesson_url,
            target: "_blank",
            rel: "noopener noreferrer",
            class: "inline-flex items-center justify-center rounded-xl bg-[var(--color-accent)] px-4 py-2.5 text-xs font-semibold text-[var(--color-bg)] hover:brightness-110 sm:text-sm" %>
    </div>
  </div>
</div>
