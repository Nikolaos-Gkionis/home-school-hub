<%# locals: slot:, user:, empty_copy:, now: false %>
<% now = local_assigns.fetch(:now, false) %>
<% lesson = slot.lesson %>

<% if slot.lunch? || slot.break? %>
  <div class="flex items-center gap-3 rounded-2xl border border-[var(--color-border)] bg-[var(--color-hover)] px-4 py-3 <%= "outline outline-2 outline-offset-1 outline-red-400" if now %>">
    <span class="w-24 shrink-0 text-xs font-semibold text-[var(--color-text-muted)]"><%= slot.clock_range %></span>
    <p class="flex items-center gap-2 text-sm font-semibold text-[var(--color-text-muted)]">
      <% if slot.lunch? %>
        <i class="fa-solid fa-utensils" aria-hidden="true"></i>
        Lunch · 30 min
      <% else %>
        <i class="fa-solid fa-mug-hot" aria-hidden="true"></i>
        Comfort break · 15 min
      <% end %>
    </p>
    <% if now %>
      <span class="ml-auto rounded-full bg-red-600 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-white">Now</span>
    <% end %>
  </div>
<% else %>
  <% swatch_subject = lesson&.subject || (slot.kind == :core ? nil : Lesson::MUSIC_SUBJECT_NAME) %>
  <div class="hub-card flex h-full flex-col gap-3 <%= "outline outline-2 outline-offset-1 outline-red-400" if now %>" style="<%= subject_tint_style(swatch_subject) if lesson %>">
    <div class="flex items-start justify-between gap-2">
      <div class="flex items-center gap-2">
        <span
          class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-sm font-semibold text-[var(--color-on-accent)]"
          style="<%= subject_swatch_style(swatch_subject) %>"
          aria-hidden="true"
        ><%= slot.hour %></span>
        <div class="min-w-0">
          <p class="text-xs font-semibold uppercase tracking-wide text-[var(--color-text-muted)]"><%= slot.clock_range %> · <%= slot.period %></p>
          <h3 class="font-display text-lg font-semibold text-[var(--color-text)]"><%= slot.label %></h3>
        </div>
      </div>
      <span class="flex shrink-0 items-center gap-2">
        <% if now %>
          <span class="rounded-full bg-red-600 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-white">Now</span>
        <% end %>
        <% if lesson && user.completed?(lesson) %>
          <span class="rounded-full bg-[var(--color-hover)] px-3 py-1.5 text-sm font-semibold text-[var(--color-accent)]">Done</span>
        <% end %>
      </span>
    </div>

    <% if lesson %>
      <p class="text-sm text-[var(--color-text)]"><%= lesson.title %></p>
      <p class="text-xs text-[var(--color-text-muted)]"><%= lesson.subject %><%= " · #{lesson.unit}" if lesson.unit.present? %></p>
      <%= link_to "Open", hub_dashboard_path(lesson_id: lesson.id), class: "hub-btn hub-btn-primary hub-btn-sm mt-auto self-start" %>
    <% else %>
      <p class="text-sm text-[var(--color-text-muted)]"><%= empty_copy %></p>
    <% end %>
  </div>
<% end %>
