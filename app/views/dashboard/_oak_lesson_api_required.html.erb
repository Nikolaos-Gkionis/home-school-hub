<%# locals: lesson: %>
<div class="flex min-h-0 flex-1 flex-col justify-center gap-4 overflow-y-auto rounded-xl border border-dashed border-amber-400/30 bg-amber-950/20 p-6 sm:p-8">
  <h2 class="font-display text-sm font-semibold text-[var(--color-text)]">Oak API key required</h2>
  <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">
    This lesson loads from the <strong>Oak Curriculum API</strong>. Set <code class="rounded bg-black/25 px-1 text-xs">OAK_API_TOKEN</code> in the server environment, restart the app, then run
    <code class="rounded bg-black/25 px-1 text-xs">bin/rails curriculum:oak_sync</code>
    so summaries, video, and quizzes can be fetched. See <%= link_to "Oak API overview", "https://open-api.thenational.academy/docs/about-oaks-api/api-overview", class: "text-[var(--color-accent)] underline", target: "_blank", rel: "noopener noreferrer" %>.
  </p>
  <p class="text-sm text-[var(--color-text-muted)]">
    <%= link_to "Open this lesson on Oak National Academy (new tab)",
          lesson.oak_pupil_lesson_url,
          target: "_blank",
          rel: "noopener noreferrer",
          class: "inline-flex font-medium text-[var(--color-accent)] underline hover:opacity-90" %>
  </p>
</div>
