<% content_for :title, "Dashboard — HomeSchool Hub" %>

<% if @month_overview %>
  <%= render "dashboard/month_overview" %>
<% elsif @lesson.blank? %>
  <%= render "shared/hub_empty_state",
      title: "No lessons in your scope yet",
      body: "Ask a parent to pick your year, or widen subject filters in the sidebar. If you are setting the hub up, add an Oak API token and run bin/rails curriculum:oak_sync.",
      icon: "fa-book-open" %>
<% else %>
  <div
    class="flex h-full min-h-0 w-full max-w-none flex-col gap-3"
    data-controller="lesson-timer"
    data-lesson-timer-url-value="<%= lesson_time_log_path(lesson_id: @lesson.id) %>"
    data-lesson-timer-interval-value="45"
  >
    <header class="flex flex-none flex-col gap-2 sm:flex-row sm:items-center sm:justify-between sm:gap-3">
      <div class="min-w-0">
        <h1 class="font-display truncate text-lg font-semibold tracking-tight text-[var(--color-text)] sm:text-xl">
          <%= @lesson.title %>
        </h1>
        <% meta = @lesson.summary_data %>
        <% line = [ meta["subjectTitle"].presence || @lesson.subject, meta["keyStageTitle"], @lesson.unit ].compact.join(" · ") %>
        <p class="mt-0.5 truncate text-sm text-[var(--color-text-muted)]" title="<%= line %>">
          <%= line %>
        </p>
      </div>

      <div class="flex flex-none flex-wrap items-center gap-2">
        <%= link_to "Open on Oak (new tab)",
              @lesson.oak_pupil_lesson_url,
              target: "_blank",
              rel: "noopener noreferrer",
              class: "hub-btn hub-btn-secondary hub-btn-sm" %>
        <%= render "lessons/status", lesson: @lesson, user: current_user %>
      </div>
    </header>

    <div class="relative flex min-h-0 w-full flex-1 flex-col overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-2 shadow-[var(--shadow-card)] sm:p-3">
      <%= render "dashboard/lesson_content", lesson: @lesson, user: current_user %>
    </div>
  </div>
<% end %>
