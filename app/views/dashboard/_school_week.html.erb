<%# locals: school_week:, user: %>
<% content_for :title, "This week — HomeSchool Hub" %>
<% current_period = Curriculum::TimetableClock.current_period_key %>
<% now_line = Curriculum::TimetableClock.now_line_style %>
<% preview_name = current_user.parent? && user&.learner? ? user.family_display_name : nil %>

<div class="mx-auto w-full max-w-6xl space-y-6 pb-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div class="min-w-0 flex-1">
      <%= render "shared/hub_page_header",
          kicker: [ "This week", preview_name ].compact.join(" · "),
          title: school_week.label,
          description: preview_name ? "The same Monday–Friday timetable #{preview_name} sees. Tap a lesson to open it, or switch to Day for today’s cards." : "Monday to Friday, 09:00–15:15. Tap a lesson to open it, or switch to Day for today’s cards." %>
    </div>
    <%= render "dashboard/timetable_switch", date: school_week.monday %>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-2 week-screen-only">
    <% if school_week.previous_week_in_term? %>
      <%= link_to hub_dashboard_path(view: "week", date: school_week.previous_monday.iso8601), class: "hub-btn hub-btn-secondary hub-btn-sm" do %>
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        Previous week
      <% end %>
    <% else %>
      <span class="hub-btn hub-btn-secondary hub-btn-sm pointer-events-none opacity-40">Previous week</span>
    <% end %>
    <%= link_to hub_dashboard_path(view: "week", date: Date.current.iso8601), class: "hub-btn hub-btn-ghost hub-btn-sm" do %>
      This week
    <% end %>
    <% if school_week.next_week_in_term? %>
      <%= link_to hub_dashboard_path(view: "week", date: school_week.next_monday.iso8601), class: "hub-btn hub-btn-secondary hub-btn-sm" do %>
        Next week
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      <% end %>
    <% else %>
      <span class="hub-btn hub-btn-secondary hub-btn-sm pointer-events-none opacity-40">Next week</span>
    <% end %>
  </div>

  <p class="text-xs text-[var(--color-text-muted)]">Comfort breaks are 15 minutes. Lunch is 30 minutes.</p>

  <div id="week-calendar-board" class="week-board" style="--week-days: <%= school_week.days.size %>;">
    <div class="week-board-head">
      <div class="week-board-time-gutter" aria-hidden="true"></div>
      <% school_week.days.each do |day| %>
        <%= link_to hub_dashboard_path(view: "day", date: day.date.iso8601),
              class: "week-board-day-head #{ "is-today" if day.today? } #{ "is-out" unless day.in_term? }" do %>
          <span class="block text-xs font-semibold uppercase tracking-wide"><%= day.short_weekday %></span>
          <span class="block text-sm"><%= day.day_label %></span>
        <% end %>
      <% end %>
    </div>

    <div class="week-board-body">
      <div class="week-board-time-gutter" style="<%= Curriculum::TimetableClock.day_height_style %>">
        <% Curriculum::TimetableClock::HOUR_MARKS.each do |mark| %>
          <div class="week-board-hour-label <%= "is-first" if mark == Curriculum::TimetableClock::HOUR_MARKS.first %> <%= "is-last" if mark == Curriculum::TimetableClock::HOUR_MARKS.last %>" style="<%= Curriculum::TimetableClock.hour_mark_style(mark) %>"><%= mark %></div>
        <% end %>
      </div>

      <% school_week.days.each do |day| %>
        <div class="week-board-day <%= "is-today" if day.today? %> <%= "is-out" unless day.in_term? %>" style="<%= Curriculum::TimetableClock.day_height_style %>">
          <% Curriculum::TimetableClock::HOUR_MARKS.each do |mark| %>
            <div class="week-board-hour-line" style="<%= Curriculum::TimetableClock.hour_mark_style(mark) %>" aria-hidden="true"></div>
          <% end %>
          <% if day.in_term? && day.today? && now_line %>
            <div class="week-board-now-line" style="<%= now_line %>" aria-hidden="true">
              <span class="week-board-now-dot"></span>
            </div>
          <% end %>

          <% if day.in_term? %>
            <% day.timeline.each do |slot| %>
              <% clock = Curriculum::TimetableClock.period_for(slot.key) %>
              <%# teaching? means a lesson hour; otherwise this is a break or lunch strip. %>
              <div
                class="week-board-block week-board-<%= slot.teaching? ? "lesson" : slot.kind %> <%= "is-now" if day.today? && slot.key == current_period %>"
                style="<%= Curriculum::TimetableClock.block_style(clock) %>"
              >
                <%= render "dashboard/school_week_cell", slot: slot, user: user %>
              </div>
            <% end %>
          <% else %>
            <p class="week-board-muted" style="padding-top: 2rem; text-align: center;">Holiday</p>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="week-board-mobile">
    <% school_week.days.each do |day| %>
      <section class="hub-card <%= "ring-2 ring-[var(--color-accent)]" if day.today? %>">
        <h2 class="font-display text-lg font-semibold text-[var(--color-text)]">
          <%= link_to day.weekday_name, hub_dashboard_path(view: "day", date: day.date.iso8601), class: "hover:underline" %>
          <span class="text-sm font-normal text-[var(--color-text-muted)]"> · <%= day.date.strftime("%-d %B") %></span>
        </h2>
        <% unless day.in_term? %>
          <p class="mt-1 text-sm text-[var(--color-text-muted)]">Holiday — term ends at the end of the third week in July.</p>
        <% else %>
          <ol class="mt-3 space-y-2">
            <% day.timeline.each do |slot| %>
              <li class="flex gap-3 rounded-xl border border-[var(--color-border)] px-3 py-2 <%= "bg-[var(--color-nav-active)]" if day.today? && slot.key == current_period %>">
                <span class="w-16 shrink-0 text-xs font-semibold text-[var(--color-text-muted)]"><%= slot.starts_at %></span>
                <div class="min-w-0 flex-1">
                  <%= render "dashboard/school_week_cell", slot: slot, user: user, compact: true %>
                </div>
              </li>
            <% end %>
          </ol>
        <% end %>
      </section>
    <% end %>
  </div>
</div>
