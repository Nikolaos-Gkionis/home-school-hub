<%# locals: lesson:, qb: %>
<% quiz_header_icon = qb[:section_key].to_s == "exit_quiz" ? "fa-comments" : "fa-clipboard-question" %>
<%= tag.div(
      class: "rounded-2xl bg-emerald-50/70 p-3 ring-1 ring-emerald-200/60 dark:bg-emerald-950/25 dark:ring-emerald-800/40 sm:p-4",
      data: {
        controller: "oak-quiz",
        oak_quiz_quiz_type_value: qb[:qt],
        oak_quiz_submit_url_value: lesson_quiz_responses_path(lesson_id: lesson.id),
        oak_quiz_title_value: qb[:title],
        oak_quiz_questions_value: qb[:questions].to_json
      }
    ) do %>
  <div
    data-oak-quiz-target="questionPhase"
    class="overflow-hidden rounded-3xl border-2 border-emerald-200/70 bg-[var(--color-surface)] shadow-sm dark:border-emerald-800/50"
  >
    <div class="flex items-start justify-between gap-3 border-b border-emerald-100/80 px-4 py-3 dark:border-emerald-900/40 sm:px-5 sm:py-4">
      <div class="flex min-w-0 items-center gap-2">
        <button
          type="button"
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-lg text-neutral-700 hover:bg-emerald-50 dark:text-[var(--color-text)] dark:hover:bg-white/5"
          data-action="click->oak-quiz#headerBack"
          aria-label="Back"
        >
          <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
        </button>
        <i class="fa-solid <%= quiz_header_icon %> text-lg text-emerald-700 dark:text-emerald-400" aria-hidden="true"></i>
        <h2 class="font-display truncate text-base font-bold text-neutral-900 dark:text-[var(--color-text)] sm:text-lg" data-oak-quiz-target="headerTitle"></h2>
      </div>
      <div class="shrink-0 text-right">
        <p class="text-sm font-bold text-neutral-900 dark:text-[var(--color-text)]" data-oak-quiz-target="progressText">—</p>
        <div class="mt-1 flex max-w-[8rem] gap-1 sm:max-w-xs" data-oak-quiz-target="progressTrack"></div>
      </div>
    </div>

    <div class="px-4 py-4 sm:px-6 sm:py-5">
      <p class="text-lg font-bold leading-snug text-neutral-950 dark:text-[var(--color-text)] sm:text-xl" data-oak-quiz-target="questionText"></p>
      <div class="mt-4 hidden" data-oak-quiz-target="questionMedia"></div>

      <span
        class="mt-3 inline-block rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-900 dark:bg-emerald-900/40 dark:text-emerald-100"
        data-oak-quiz-target="instructionPill"
      >Select one answer</span>

      <div class="mt-5 space-y-3" data-oak-quiz-target="options"></div>

      <div
        class="mt-5 hidden rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-950 dark:border-amber-700/50 dark:bg-amber-950/40 dark:text-amber-100"
        data-oak-quiz-target="hintSection"
      >
        <p data-oak-quiz-target="hintText"></p>
        <button
          type="button"
          class="mt-2 inline-flex items-center gap-1.5 text-xs font-semibold text-amber-900 underline decoration-dotted dark:text-amber-200"
          data-action="click->oak-quiz#toggleHint"
        >
          <i class="fa-regular fa-lightbulb" aria-hidden="true"></i>
          <span data-oak-quiz-target="hintToggleLabel">Close hint</span>
        </button>
      </div>

      <div
        class="mt-6 hidden flex items-start gap-2 border-t border-emerald-100/80 pt-4 dark:border-emerald-900/40"
        data-oak-quiz-target="feedback"
      >
        <span data-oak-quiz-target="feedbackIcon" aria-hidden="true"></span>
        <div>
          <p data-oak-quiz-target="feedbackTitle"></p>
          <p class="mt-1 text-sm text-neutral-600 dark:text-[var(--color-text-muted)]" data-oak-quiz-target="feedbackSub"></p>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap items-center justify-end gap-3">
        <button
          type="button"
          class="inline-flex items-center gap-2 rounded-xl bg-neutral-800 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-neutral-900 disabled:cursor-not-allowed disabled:opacity-40 dark:bg-neutral-200 dark:text-neutral-900 dark:hover:bg-white"
          data-oak-quiz-target="checkBtn"
          data-action="click->oak-quiz#checkAnswer"
        >
          Check <span aria-hidden="true">→</span>
        </button>
        <button
          type="button"
          class="hidden inline-flex items-center gap-2 rounded-xl bg-neutral-800 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-neutral-900 dark:bg-neutral-200 dark:text-neutral-900 dark:hover:bg-white"
          data-oak-quiz-target="nextBtn"
          data-action="click->oak-quiz#nextQuestion"
        >
          Next question <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>

  <div data-oak-quiz-target="completePhase" class="hidden rounded-3xl border-2 border-emerald-200/70 bg-[var(--color-surface)] px-4 py-8 text-center shadow-sm dark:border-emerald-800/50 sm:px-6">
    <p class="font-display text-lg font-semibold text-[var(--color-text)]">Quiz complete</p>
    <p class="mt-2 text-sm text-[var(--color-text-muted)]">Nice work — pick another step from the lesson overview when you&rsquo;re ready.</p>
    <button
      type="button"
      class="mt-6 inline-flex cursor-pointer items-center justify-center rounded-xl bg-neutral-800 px-5 py-3 text-sm font-semibold text-white dark:bg-neutral-200 dark:text-neutral-900"
      data-action="click->oak-lesson-steps#showOverview"
    >
      Back to lesson overview
    </button>
  </div>
<% end %>
