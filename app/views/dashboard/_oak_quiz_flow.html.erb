<%# locals: lesson:, qb: %>
<% quiz_header_icon = qb[:section_key].to_s == "exit_quiz" ? "fa-comments" : "fa-clipboard-question" %>
<%= tag.div(
      class: "rounded-2xl bg-[var(--color-hover)] p-3 ring-1 ring-[var(--color-border)] sm:p-4",
      data: {
        controller: "oak-quiz",
        oak_quiz_quiz_type_value: qb[:qt],
        oak_quiz_submit_url_value: lesson_quiz_responses_path(lesson_id: lesson.id),
        oak_quiz_title_value: qb[:title],
        oak_quiz_questions_value: qb[:questions].to_json
      }
    ) do %>
  <div
    data-oak-quiz-target="questionPhase"
    class="overflow-hidden rounded-3xl border-2 border-[var(--color-border)] bg-[var(--color-surface)] shadow-[var(--shadow-card)]"
  >
    <div class="flex items-start justify-between gap-3 border-b border-[var(--color-border)] px-4 py-3 sm:px-5 sm:py-4">
      <div class="flex min-w-0 items-center gap-2">
        <button
          type="button"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-lg text-[var(--color-text)] hover:bg-[var(--color-hover)]"
          data-action="click->oak-quiz#headerBack"
          aria-label="Back"
        >
          <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
        </button>
        <i class="fa-solid <%= quiz_header_icon %> text-lg text-[var(--color-accent)]" aria-hidden="true"></i>
        <h2 class="font-display truncate text-base font-bold text-[var(--color-text)] sm:text-lg" data-oak-quiz-target="headerTitle"></h2>
      </div>
      <div class="shrink-0 text-right">
        <p class="text-sm font-bold text-[var(--color-text)]" data-oak-quiz-target="progressText">—</p>
        <div class="mt-1 flex max-w-[8rem] gap-1 sm:max-w-xs" data-oak-quiz-target="progressTrack"></div>
      </div>
    </div>

    <div class="px-4 py-4 sm:px-6 sm:py-5">
      <p class="text-lg font-bold leading-snug text-[var(--color-text)] sm:text-xl" data-oak-quiz-target="questionText"></p>
      <div class="mt-4 hidden" data-oak-quiz-target="questionMedia"></div>

      <span
        class="mt-3 inline-block rounded-full bg-[var(--color-hover)] px-3 py-1 text-xs font-semibold text-[var(--color-accent)]"
        data-oak-quiz-target="instructionPill"
      >Select one answer</span>

      <div class="mt-5 space-y-3" data-oak-quiz-target="options"></div>

      <div
        class="mt-5 hidden rounded-xl border border-[var(--color-warning)]/30 bg-[color-mix(in_srgb,var(--color-warning)_10%,white)] px-3 py-2 text-sm text-[var(--color-text)]"
        data-oak-quiz-target="hintSection"
      >
        <p data-oak-quiz-target="hintText"></p>
        <button
          type="button"
          class="mt-2 inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--color-warning)] underline decoration-dotted"
          data-action="click->oak-quiz#toggleHint"
        >
          <i class="fa-regular fa-lightbulb" aria-hidden="true"></i>
          <span data-oak-quiz-target="hintToggleLabel">Close hint</span>
        </button>
      </div>

      <div
        class="mt-6 hidden flex items-start gap-2 border-t border-[var(--color-border)] pt-4"
        data-oak-quiz-target="feedback"
      >
        <span data-oak-quiz-target="feedbackIcon" aria-hidden="true"></span>
        <div>
          <p data-oak-quiz-target="feedbackTitle"></p>
          <p class="mt-1 text-sm text-[var(--color-text-muted)]" data-oak-quiz-target="feedbackSub"></p>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap items-center justify-end gap-3">
        <button
          type="button"
          class="hub-btn hub-btn-primary disabled:cursor-not-allowed disabled:opacity-40"
          data-oak-quiz-target="checkBtn"
          data-action="click->oak-quiz#checkAnswer"
        >
          Check <span aria-hidden="true">→</span>
        </button>
        <button
          type="button"
          class="hub-btn hub-btn-primary hidden"
          data-oak-quiz-target="nextBtn"
          data-action="click->oak-quiz#nextQuestion"
        >
          Next question <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>

  <div data-oak-quiz-target="completePhase" class="hidden rounded-3xl border-2 border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-8 text-center shadow-[var(--shadow-card)] sm:px-6">
    <p class="font-display text-lg font-semibold text-[var(--color-text)]">Quiz complete</p>
    <p class="mt-2 text-sm text-[var(--color-text-muted)]">Nice work — pick another step from the lesson overview when you&rsquo;re ready.</p>
    <button
      type="button"
      class="hub-btn hub-btn-primary mt-6"
      data-action="click->oak-lesson-steps#showOverview"
    >
      Back to lesson overview
    </button>
  </div>
<% end %>
