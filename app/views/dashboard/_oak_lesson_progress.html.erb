<%# locals: lesson:, user: %>
<% sp = lesson.hub_section_progress_for(user) %>
<% qp = lesson.quiz_mc_progress_for(user) %>
<div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)]/50 px-3 py-2 text-xs text-[var(--color-text-muted)] sm:text-sm">
  <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
    <span>
      Sections:
      <strong class="text-[var(--color-text)]"><%= sp[:seen] %>/<%= sp[:total] %></strong>
    </span>
    <% if qp[:total].positive? %>
      <span>
        Quiz (multiple choice):
        <strong class="text-[var(--color-text)]"><%= qp[:answered] %>/<%= qp[:total] %></strong>
        answered
        <% if qp[:answered].positive? %>
          · <strong class="text-[var(--color-accent)]"><%= qp[:correct] %></strong> correct
        <% end %>
      </span>
    <% end %>
  </div>
</div>
