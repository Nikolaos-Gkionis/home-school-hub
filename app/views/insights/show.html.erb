<% content_for :title, "Insights — HomeSchool Hub" %>

<div class="mx-auto max-w-4xl space-y-6 pb-8">
  <header class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="font-display text-xl font-bold text-[var(--color-text)] sm:text-2xl">Insights</h1>
      <p class="mt-1 text-sm text-[var(--color-text-muted)]">Progress, quiz success, and time on lessons (tracked in this hub).</p>
    </div>
    <% if current_user.parent? && @children.any? %>
      <%= form_with url: insights_path, method: :get, class: "flex items-center gap-2", data: { turbo: true } do %>
        <label class="text-xs text-[var(--color-text-muted)]">View</label>
        <%= select_tag :child_id,
            options_for_select(
              [ [ "All learners", "" ] ] + @children.map { |c| [ c.email, c.id ] },
              params[:child_id]
            ),
            class: "rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] px-2 py-1.5 text-xs",
            onchange: "this.form.requestSubmit()" %>
      <% end %>
    <% end %>
  </header>

  <% m = @metrics %>
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <% [
      [ "Learners in view", m[:learner_count] ],
      [ "Lessons completed", m[:lessons_completed] ],
      [ "Quiz success", "#{(m[:quiz_success_ratio].to_f * 100).round(1)}%" ],
      [ "Time (minutes)", m[:time_minutes] ]
    ].each do |label, val| %>
      <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]/50 p-4 shadow-sm">
        <p class="text-[10px] font-semibold uppercase tracking-wide text-[var(--color-text-muted)]"><%= label %></p>
        <p class="mt-1 font-display text-2xl font-bold text-[var(--color-accent)]"><%= val %></p>
      </div>
    <% end %>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]/40 p-4">
      <h2 class="font-display text-sm font-semibold text-[var(--color-text)]">Completions by week</h2>
      <div class="mt-4 flex h-40 items-end gap-1">
        <% max = [ m[:completions_by_week].values.max.to_i, 1 ].max %>
        <% m[:completions_by_week].sort_by { |k, _| k }.last(12).each do |week, count| %>
          <div class="flex flex-1 flex-col items-center justify-end gap-1">
            <div
              class="w-full max-w-[24px] rounded-t-md bg-[var(--color-accent)]/80"
              style="height: <%= (count.to_f / max * 100).round(1) %>%"
              title="<%= week %>: <%= count %>"
            ></div>
            <span class="max-w-full truncate text-[9px] text-[var(--color-text-muted)]"><%= week.to_s.last(5) %></span>
          </div>
        <% end %>
        <% if m[:completions_by_week].empty? %>
          <p class="text-sm text-[var(--color-text-muted)]">No data yet — complete a lesson to see bars here.</p>
        <% end %>
      </div>
    </div>

    <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]/40 p-4">
      <h2 class="font-display text-sm font-semibold text-[var(--color-text)]">By subject</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <% m[:completions_by_subject].sort_by { |_, c| -c }.first(10).each do |subj, count| %>
          <li class="flex justify-between gap-2 border-b border-[var(--color-border)]/40 pb-2">
            <span class="truncate text-[var(--color-text)]"><%= subj %></span>
            <span class="shrink-0 font-medium text-[var(--color-accent)]"><%= count %></span>
          </li>
        <% end %>
        <% if m[:completions_by_subject].empty? %>
          <li class="text-[var(--color-text-muted)]">No completions yet.</li>
        <% end %>
      </ul>
    </div>
  </div>

  <p class="text-xs text-[var(--color-text-muted)]">
    Quiz counts include multiple-choice attempts saved from lesson quizzes. Time accrues while a lesson is open (timer in the lesson panel).
  </p>
</div>
