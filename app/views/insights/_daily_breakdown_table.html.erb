<div class="hub-card">
  <h2 class="font-display text-sm font-semibold text-[var(--color-text)]"><%= title %></h2>
  <p class="mt-1 text-xs text-[var(--color-text-muted)]"><%= description %></p>

  <% if @daily_dates_total_pages > 1 && local_assigns[:show_pagination] %>
    <%= render "insights/daily_dates_pagination" %>
  <% end %>

  <div class="mt-3 overflow-x-auto">
    <table class="w-full text-left text-xs sm:text-sm">
      <thead>
        <tr class="border-b border-[var(--color-border)] text-[10px] font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">
          <th class="py-2 pr-3 whitespace-nowrap">Learner</th>
          <% @daily_dates.each do |date| %>
            <th class="py-2 px-2 text-right whitespace-nowrap tabular-nums" title="<%= date %>">
              <%= insights_day_label(date) %>
            </th>
          <% end %>
          <th class="py-2 pl-2 text-right whitespace-nowrap">Total</th>
        </tr>
      </thead>
      <tbody>
        <% rows.each do |row| %>
          <tr class="border-b border-[var(--color-border)]/40">
            <td class="py-2 pr-3 whitespace-nowrap text-[var(--color-text)]"><%= row[:label] %></td>
            <% @daily_dates.each do |date| %>
              <td class="py-2 px-2 text-right whitespace-nowrap tabular-nums text-[var(--color-text)]"><%= row[:by_date][date] %></td>
            <% end %>
            <td class="py-2 pl-2 text-right whitespace-nowrap tabular-nums font-semibold text-[var(--color-accent)]"><%= row[:total] %></td>
          </tr>
        <% end %>
        <tr class="border-b-0">
          <td class="py-2 pr-3 whitespace-nowrap font-semibold text-[var(--color-text)]">Totals</td>
          <% @daily_dates.each do |date| %>
            <td class="py-2 px-2 text-right whitespace-nowrap tabular-nums font-semibold text-[var(--color-text)]"><%= totals[date] %></td>
          <% end %>
          <td class="py-2 pl-2 text-right whitespace-nowrap tabular-nums font-semibold text-[var(--color-accent)]"><%= total_cell %></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
