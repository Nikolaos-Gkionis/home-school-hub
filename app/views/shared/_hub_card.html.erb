<%# optional: title %>
<div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]/60 p-4 shadow-sm ring-1 ring-[var(--color-accent)]/8">
  <% if local_assigns[:title].present? %>
    <p class="mb-3 font-display text-sm font-semibold text-[var(--color-text)]"><%= title %></p>
  <% end %>
  <%= yield %>
</div>
