<%# Used by Turbo.setConfirmMethod (see turbo_confirm.js) for data-turbo-confirm. %>
<dialog
  id="hub-confirm-dialog"
  class="hub-confirm-dialog max-h-[90dvh] w-full max-w-md rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-surface)] p-0 text-[var(--color-text)] shadow-[var(--shadow-card)]"
  aria-labelledby="hub-confirm-title"
>
  <div class="p-6">
    <h2 id="hub-confirm-title" class="font-display text-lg font-semibold text-[var(--color-text)]">
      Are you sure?
    </h2>
    <p class="mt-3 text-sm leading-relaxed text-[var(--color-text-muted)]" data-hub-confirm-message></p>
    <div class="mt-6 flex flex-wrap items-center justify-end gap-2">
      <button
        type="button"
        data-hub-confirm-cancel
        class="hub-btn hub-btn-ghost hub-btn-sm"
      >
        Cancel
      </button>
      <button
        type="button"
        data-hub-confirm-ok
        class="hub-btn hub-btn-danger hub-btn-sm"
      >
        Confirm
      </button>
    </div>
  </div>
</dialog>
