<%# Used by Turbo.setConfirmMethod (see turbo_confirm.js) for data-turbo-confirm. %>
<dialog
  id="hub-confirm-dialog"
  class="hub-confirm-dialog max-h-[90dvh] w-full max-w-md rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-0 text-[var(--color-text)] shadow-2xl"
  aria-labelledby="hub-confirm-title"
>
  <div class="p-6">
    <h2 id="hub-confirm-title" class="font-display text-base font-semibold text-[var(--color-text)]">
      Are you sure?
    </h2>
    <p class="mt-3 text-sm leading-relaxed text-[var(--color-text-muted)]" data-hub-confirm-message></p>
    <div class="mt-6 flex flex-wrap items-center justify-end gap-2">
      <button
        type="button"
        data-hub-confirm-cancel
        class="inline-flex items-center justify-center rounded-lg border border-[var(--color-border)] bg-transparent px-4 py-2 text-sm font-medium text-[var(--color-text-muted)] hover:bg-white/5 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]/50"
      >
        Cancel
      </button>
      <button
        type="button"
        data-hub-confirm-ok
        class="inline-flex items-center justify-center rounded-lg bg-red-600/90 px-4 py-2 text-sm font-semibold text-white hover:bg-red-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-400 focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-surface)]"
      >
        Confirm
      </button>
    </div>
  </div>
</dialog>
