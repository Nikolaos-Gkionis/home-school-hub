<% lessons_by_unit = lessons_for_subject.group_by(&:unit).sort_by { |_unit_title, ls| ls.map(&:unit_position).compact.min || 9999 }.to_h %>
<% subj_status = sidebar_subject_status(completed, lessons_by_unit) %>
<% nav_subject_key = Lesson.compose_nav_subject_key(year_key, subject) %>
<% al = local_assigns[:active_lesson] %>
<% current_subject = al.present? && al.year_group_key.to_s == year_key.to_s && al.subject.to_s == subject.to_s %>
<%= tag.details(
      class: "mb-0.5 rounded-md",
      open: user.subject_expanded?(year_key, subject),
      data: { sidebar_nav_subject: true, subject_key: nav_subject_key }
    ) do %>
  <%= tag.summary(class: sidebar_subject_summary_classes(subj_status, current: current_subject)) do %>
    <span class="flex min-w-0 flex-1 items-start gap-2">
      <%= sidebar_status_dot(subj_status) %>
      <span class="min-w-0 flex-1 text-left text-xs font-semibold leading-snug sm:text-sm">
        <span class="line-clamp-2 break-words"><%= subject == Lesson::OAK_SUBJECT_NAME ? subject : subject.titleize %></span>
      </span>
      <% if current_subject %>
        <span class="shrink-0 rounded border border-[var(--color-border)] bg-[var(--color-bg)]/80 px-1 py-0.5 text-[8px] font-bold uppercase tracking-wide text-[var(--color-accent)]" title="Matches the lesson open in the main panel">Now</span>
      <% end %>
    </span>
    <i class="fa-solid fa-chevron-right sidebar-details-chevron mt-0.5 shrink-0" aria-hidden="true"></i>
  <% end %>

  <div class="ml-0.5 border-l border-[var(--color-border)]/40 pl-1.5">
    <% lessons_by_unit.each do |unit, lessons| %>
      <% ustatus = sidebar_unit_status(completed, lessons) %>
      <% nav_unit_key = Lesson.compose_nav_unit_key(year_key, subject, unit) %>
      <%= tag.details(
            class: "mb-0.5",
            open: user.unit_expanded?(nav_unit_key),
            data: { sidebar_nav_unit: true, unit_key: nav_unit_key }
          ) do %>
        <% current_unit = al.present? && al.year_group_key.to_s == year_key.to_s && al.subject.to_s == subject.to_s && al.unit.to_s == unit.to_s %>
        <%= tag.summary(class: sidebar_unit_summary_classes(ustatus, current: current_unit)) do %>
          <span class="flex min-w-0 flex-1 items-start gap-2">
            <%= sidebar_status_dot(ustatus) %>
            <span class="min-w-0 flex-1 text-left font-medium leading-snug">
              <span class="line-clamp-2 break-words"><%= unit %></span>
            </span>
          </span>
          <i class="fa-solid fa-chevron-right sidebar-details-chevron mt-0.5 shrink-0" aria-hidden="true"></i>
        <% end %>

        <div class="ml-0.5 space-y-0.5 border-l border-[var(--color-border)]/25 py-0.5 pl-1.5">
          <% locked = !user.unit_unlocked?(subject, unit, year_group_key: year_key) %>
          <% unlock_plan = locked ? user.plan_for_unit(subject, unit, year_group_key: year_key) : nil %>
          <% if locked %>
            <p class="flex items-start gap-1.5 rounded-xl px-1.5 py-1 text-xs text-[var(--color-locked)]">
              <i class="fa-solid fa-lock mt-0.5 shrink-0" aria-hidden="true"></i>
              <span>
                Locked
                <% if unlock_plan %>
                  · unlocks in <%= Curriculum::AcademicYear.label_for(unlock_plan.month) %>
                <% else %>
                  · ask a parent to add this to a month
                <% end %>
              </span>
            </p>
          <% else %>
            <% lessons.sort_by(&:position).each do |lesson| %>
              <% active = highlight.present? && highlight.to_i == lesson.id %>
              <%= link_to current_user.parent? ? parent_dashboard_path(lesson_id: lesson.id) : child_dashboard_path(lesson_id: lesson.id),
                  class: "flex min-w-0 items-start gap-1.5 rounded-xl px-1.5 py-1.5 text-xs hover:bg-[var(--color-hover)] #{active ? "bg-[var(--color-nav-active)] font-semibold text-[var(--color-accent)]" : "text-[var(--color-text-muted)]"}",
                  **(active ? { aria: { current: "page" } } : {}) do %>
                <i class="fa-solid fa-book fa-fw mt-0.5 shrink-0 text-[9px] opacity-70" aria-hidden="true"></i>
                <span class="min-w-0 flex-1 leading-snug">
                  <span class="line-clamp-3 break-words"><%= lesson.title %></span>
                </span>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
