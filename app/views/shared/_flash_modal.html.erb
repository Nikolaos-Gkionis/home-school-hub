<%# Flash from redirects / flash.now — centered modal instead of corner alerts. %>
<% if notice.present? || alert.present? %>
  <% variant = alert.present? ? "alert" : "notice" %>
  <% body = (alert.presence || notice).to_s %>
  <div
    data-controller="flash-modal"
    data-action="click->flash-modal#closeOnBackdrop"
    class="fixed inset-0 z-[200] flex items-center justify-center bg-black/55 p-4 backdrop-blur-[2px]"
  >
    <div
      class="w-full max-w-md rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 shadow-2xl shadow-black/40"
      role="<%= variant == "alert" ? "alertdialog" : "dialog" %>"
      aria-modal="true"
      aria-labelledby="flash-modal-title"
      aria-describedby="flash-modal-body"
    >
      <div class="flex gap-4">
        <div
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl <%= variant == "alert" ? "bg-red-500/15 text-red-300" : "bg-[var(--color-accent)]/15 text-[var(--color-accent)]" %>"
          aria-hidden="true"
        >
          <% if variant == "alert" %>
            <i class="fa-solid fa-triangle-exclamation text-lg"></i>
          <% else %>
            <i class="fa-solid fa-circle-check text-lg"></i>
          <% end %>
        </div>
        <div class="min-w-0 flex-1 pt-0.5">
          <h2 id="flash-modal-title" class="font-display text-base font-semibold text-[var(--color-text)]">
            <%= variant == "alert" ? "Something went wrong" : "Notice" %>
          </h2>
          <p id="flash-modal-body" class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]"><%= body %></p>
          <div class="mt-6 flex justify-end">
            <button
              type="button"
              data-flash-modal-primary
              data-action="click->flash-modal#dismiss"
              class="inline-flex items-center justify-center rounded-lg bg-[var(--color-accent)] px-4 py-2 text-sm font-semibold text-[var(--color-bg)] shadow-sm hover:brightness-110 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-surface)]"
            >
              OK
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
