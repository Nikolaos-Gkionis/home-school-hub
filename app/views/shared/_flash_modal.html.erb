<%# Flash from redirects / flash.now — centered modal instead of corner alerts. %>
<% if notice.present? || alert.present? %>
  <% variant = alert.present? ? "alert" : "notice" %>
  <% body = (alert.presence || notice).to_s %>
  <div
    data-controller="flash-modal"
    data-action="click->flash-modal#closeOnBackdrop"
    class="fixed inset-0 z-[200] flex items-center justify-center bg-stone-900/40 p-4 backdrop-blur-[2px]"
  >
    <div
      class="hub-card w-full max-w-md p-6"
      role="<%= variant == "alert" ? "alertdialog" : "dialog" %>"
      aria-modal="true"
      aria-labelledby="flash-modal-title"
      aria-describedby="flash-modal-body"
    >
      <div class="flex gap-4">
        <div
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl <%= variant == "alert" ? "bg-[color-mix(in_srgb,var(--color-danger)_15%,white)] text-[var(--color-danger)]" : "bg-[var(--color-hover)] text-[var(--color-accent)]" %>"
          aria-hidden="true"
        >
          <% if variant == "alert" %>
            <i class="fa-solid fa-triangle-exclamation text-lg"></i>
          <% else %>
            <i class="fa-solid fa-circle-check text-lg"></i>
          <% end %>
        </div>
        <div class="min-w-0 flex-1 pt-0.5">
          <h2 id="flash-modal-title" class="font-display text-lg font-semibold text-[var(--color-text)]">
            <%= variant == "alert" ? "Something went wrong" : "Nice!" %>
          </h2>
          <p id="flash-modal-body" class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]"><%= body %></p>
          <div class="mt-6 flex justify-end">
            <button
              type="button"
              data-flash-modal-primary
              data-action="click->flash-modal#dismiss"
              class="hub-btn hub-btn-primary hub-btn-sm"
            >
              OK
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
