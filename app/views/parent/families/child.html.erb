<% content_for :title, "Child details — HomeSchool Hub" %>

<div class="mx-auto w-full max-w-4xl space-y-6 pb-8">
  <%= render "shared/hub_page_header",
      kicker: "Parent",
      title: @child.family_display_name,
      description: "#{@child.email} · #{Curriculum::YearGroups.label_for_year(@child.current_year_group_key)}" %>

  <p>
    <%= link_to "Change school year", parent_edit_child_path(@child), class: "inline-flex rounded-md bg-[var(--color-accent)] px-3 py-1.5 text-xs font-semibold text-[var(--color-bg)]" %>
  </p>

  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]/60 p-4">
      <p class="text-[10px] font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">Lessons completed</p>
      <p class="mt-1 font-display text-2xl font-bold text-[var(--color-accent)]"><%= @metrics[:lessons_completed] %></p>
    </div>
    <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]/60 p-4">
      <p class="text-[10px] font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">Sections viewed</p>
      <p class="mt-1 font-display text-2xl font-bold text-[var(--color-accent)]"><%= @metrics[:sections_explored] %></p>
    </div>
    <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]/60 p-4">
      <p class="text-[10px] font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">Quiz success</p>
      <p class="mt-1 font-display text-2xl font-bold text-[var(--color-accent)]"><%= (@metrics[:quiz_success_ratio].to_f * 100).round(1) %>%</p>
    </div>
    <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]/60 p-4">
      <p class="text-[10px] font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">Time (min)</p>
      <p class="mt-1 font-display text-2xl font-bold text-[var(--color-accent)]"><%= @metrics[:time_minutes] %></p>
    </div>
  </div>

  <section class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]/60 p-4 shadow-sm">
    <div class="mb-3 flex items-center justify-between gap-2">
      <h2 class="font-display text-sm font-semibold text-[var(--color-text)]">Checkpoint tests</h2>
      <p class="text-xs text-[var(--color-text-muted)]">60-90 min · 40-50 questions</p>
    </div>

    <% if @eligible_checkpoint_subjects.any? %>
      <p class="mb-3 text-sm text-[var(--color-text-muted)]">
        Subjects ready for a checkpoint test (at least <%= CheckpointTest::MIN_COMPLETED_LESSONS %> lessons completed):
      </p>
      <div class="flex flex-wrap gap-2">
        <% @eligible_checkpoint_subjects.each do |subject| %>
          <%= button_to "Create #{subject} checkpoint",
              parent_child_checkpoint_tests_path(@child, subject: subject),
              method: :post,
              class: "rounded-md bg-[var(--color-accent)] px-3 py-1.5 text-xs font-semibold text-[var(--color-bg)]" %>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-[var(--color-text-muted)]">
        No subject has enough completed lessons yet. Once a subject reaches <%= CheckpointTest::MIN_COMPLETED_LESSONS %> completed lessons, the button will appear here.
      </p>
    <% end %>

    <% if @checkpoint_tests.any? %>
      <div class="mt-4 border-t border-[var(--color-border)] pt-4">
        <h3 class="mb-2 text-xs font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">Recent files</h3>
        <ul class="space-y-2 text-sm">
          <% @checkpoint_tests.each do |checkpoint_test| %>
            <li class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-[var(--color-border)]/70 px-3 py-2">
              <span>
                <strong><%= checkpoint_test.subject %></strong>
                · <%= checkpoint_test.question_count %> questions
                · <%= checkpoint_test.created_at.to_date %>
              </span>
              <span class="flex items-center gap-2">
                <%= link_to "Questions file", parent_child_checkpoint_test_path(@child, checkpoint_test), class: "text-xs font-medium text-[var(--color-accent)] underline hover:opacity-90" %>
                <%= link_to "Answer file", answer_key_parent_child_checkpoint_test_path(@child, checkpoint_test), class: "text-xs font-medium text-[var(--color-accent)] underline hover:opacity-90" %>
              </span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </section>

  <%= link_to "Back to family", parent_family_path, class: "text-sm text-[var(--color-accent)] hover:underline" %>
</div>
