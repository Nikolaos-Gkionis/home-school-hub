<% content_for :title, "Edit child — HomeSchool Hub" %>

<div class="mx-auto w-full max-w-xl space-y-6 pb-8">
  <%= render "shared/hub_page_header",
      kicker: "Parent",
      title: "Edit child details",
      description: "Update the child name, login email, and school year. Changing year moves them onto that curriculum." %>

  <%= form_with url: parent_update_child_path(@child), method: :patch, scope: :child, class: "hub-card space-y-4" do |f| %>
    <div>
      <%= f.label :child_name, "Child name", class: "hub-label" %>
      <%= f.text_field :child_name, value: @child_name, required: true, class: "hub-input" %>
    </div>

    <div>
      <%= f.label :email, "Login email", class: "hub-label" %>
      <%= f.email_field :email, value: @child.email, required: true, class: "hub-input" %>
    </div>

    <div>
      <%= f.label :year_group_key, "School year", class: "hub-label" %>
      <%= f.select :year_group_key,
          Curriculum::YearGroups.select_options,
          { selected: @year_group_key },
          class: "hub-select" %>
      <p class="mt-1 text-[11px] text-[var(--color-text-muted)]">Year 7 progress is kept. The lesson tree will show the year you pick here.</p>
    </div>

    <div class="flex items-center gap-2">
      <%= f.submit "Save changes", class: "hub-btn hub-btn-primary" %>
      <%= link_to "Cancel", parent_family_path, class: "hub-btn hub-btn-ghost" %>
    </div>
  <% end %>
</div>
