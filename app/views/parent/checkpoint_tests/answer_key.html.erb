<% content_for :title, "Checkpoint test answers — HomeSchool Hub" %>
<% content_for :head do %>
  <style media="print">
    /* Let the browser paginate the full document instead of clipping to the app viewport shell. */
    html,
    body,
    #main-content,
    #main-content > div {
      height: auto !important;
      min-height: 0 !important;
      overflow: visible !important;
    }
  </style>
<% end %>

<div class="mx-auto w-full max-w-4xl space-y-4 pb-8">
  <div class="rounded-xl border border-[var(--color-border)] bg-white p-4 text-black shadow-sm print:shadow-none">
    <div class="mb-4 flex items-center justify-between border-b border-gray-300 pb-3">
      <div>
        <h1 class="text-xl font-bold">Checkpoint test (answer key)</h1>
        <p class="text-sm">
          Subject: <strong><%= @checkpoint_test.subject %></strong> ·
          Learner: <strong><%= @checkpoint_print_child_name %></strong>
        </p>
      </div>
      <button type="button" onclick="window.print();" class="rounded-md border border-gray-500 px-3 py-1 text-xs font-semibold text-gray-800 print:hidden">
        Print
      </button>
    </div>

    <ol class="space-y-3 pl-5">
      <% @questions.each_with_index do |question, index| %>
        <li>
          <p class="font-medium"><%= index + 1 %>. <%= question["prompt"] %></p>
          <p class="text-sm"><strong>Answer:</strong> <%= question["answer"] %></p>
          <p class="text-xs text-gray-600"><%= question["lesson_title"] %> · <%= question["unit"] %></p>
        </li>
      <% end %>
    </ol>
  </div>

  <div class="print:hidden">
    <%= link_to "Open questions file", parent_child_checkpoint_test_path(@child, @checkpoint_test), class: "text-sm font-medium text-[var(--color-accent)] underline" %>
    ·
    <%= link_to "Back to child details", parent_child_path(@child), class: "text-sm font-medium text-[var(--color-accent)] underline" %>
  </div>
</div>
