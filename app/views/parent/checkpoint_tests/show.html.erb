<% content_for :title, "Checkpoint test questions — HomeSchool Hub" %>

<div class="mx-auto w-full max-w-4xl space-y-4 pb-8">
  <div class="rounded-xl border border-[var(--color-border)] bg-white p-4 text-black shadow-sm print:shadow-none">
    <div class="mb-4 flex items-center justify-between border-b border-gray-300 pb-3">
      <div>
        <h1 class="text-xl font-bold">Checkpoint test (questions)</h1>
        <p class="text-sm">
          Subject: <strong><%= @checkpoint_test.subject %></strong> ·
          Learner: <strong><%= @checkpoint_print_child_name %></strong>
        </p>
        <p class="text-sm">
          Time: 60-90 minutes · Questions: <%= @checkpoint_test.question_count %>
        </p>
      </div>
      <button type="button" onclick="window.print();" class="rounded-md border border-gray-500 px-3 py-1 text-xs font-semibold text-gray-800 print:hidden">
        Print
      </button>
    </div>

    <ol class="space-y-4 pl-5">
      <% @questions.each_with_index do |question, index| %>
        <li>
          <p class="font-medium">
            <%= index + 1 %>. <%= question["prompt"] %>
          </p>
          <% if question["type"] == "multiple_choice" %>
            <ul class="mt-1 list-inside list-[upper-alpha] pl-3 text-sm">
              <% Array(question["options"]).each do |option| %>
                <li><%= option %></li>
              <% end %>
            </ul>
          <% else %>
            <div class="mt-2 space-y-2">
              <div class="h-6 border-b border-gray-300"></div>
              <div class="h-6 border-b border-gray-300"></div>
              <div class="h-6 border-b border-gray-300"></div>
            </div>
          <% end %>
          <p class="mt-1 text-xs text-gray-600">Unit: <%= question["unit"] %></p>
        </li>
      <% end %>
    </ol>
  </div>

  <div class="print:hidden">
    <%= link_to "Open answer key", answer_key_parent_child_checkpoint_test_path(@child, @checkpoint_test), class: "text-sm font-medium text-[var(--color-accent)] underline" %>
    ·
    <%= link_to "Back to child details", parent_child_path(@child), class: "text-sm font-medium text-[var(--color-accent)] underline" %>
  </div>
</div>
