<% content_for :title, "Parent dashboard — HomeSchool Hub" %>

<div class="mx-auto w-full max-w-6xl space-y-6 pb-8">
  <%= render "shared/hub_page_header",
      kicker: "Parent",
      title: "Family dashboard",
      description: "A snapshot of how everyone is getting on — then jump into a child’s year plan." %>

  <div class="hub-card text-sm text-[var(--color-text-muted)]">
    Charts and detailed trend data are available in
    <%= link_to "Insights", insights_path, class: "font-semibold text-[var(--color-accent)] underline hover:opacity-90" %>.
  </div>

  <% m = @metrics %>
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
    <% [
      [ "Children in view", m[:learner_count] ],
      [ "Lessons completed", m[:lessons_completed] ],
      [ "Sections viewed", m[:sections_explored] ],
      [ "Quiz success", "#{(m[:quiz_success_ratio].to_f * 100).round(1)}%" ],
      [ "Time (minutes)", m[:time_minutes] ]
    ].each do |label, value| %>
      <%= render "shared/hub_metric", label: label, value: value %>
    <% end %>
  </div>

  <section class="hub-card">
    <div class="mb-4 flex items-center justify-between gap-2">
      <h2 class="font-display text-lg font-semibold text-[var(--color-text)]">Children and school year</h2>
      <%= link_to "Family", parent_family_path, class: "text-sm font-semibold text-[var(--color-accent)] hover:underline" %>
    </div>
    <% if @children.any? %>
      <ul class="space-y-2">
        <% @children.each do |child| %>
          <% year_key = child.current_year_group_key %>
          <li class="flex flex-wrap items-center justify-between gap-2 rounded-2xl border border-[var(--color-border)] px-4 py-3">
            <span>
              <strong><%= child.family_display_name %></strong>
              <% if year_key.present? %>
                <span class="text-[var(--color-text-muted)]"> · <%= Curriculum::YearGroups.label_for_year(year_key) %></span>
              <% end %>
            </span>
            <span class="flex flex-wrap items-center gap-2">
              <%= link_to "Year plan", parent_child_plan_path(child), class: "hub-btn hub-btn-secondary hub-btn-sm" %>
              <%= link_to "Weekly calendar", parent_child_week_path(child), class: "hub-btn hub-btn-secondary hub-btn-sm" %>
              <%= link_to "Change year", parent_edit_child_path(child), class: "hub-btn hub-btn-primary hub-btn-sm" %>
            </span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-[var(--color-text-muted)]">Invite a child first, then you can set their school year here.</p>
    <% end %>
  </section>

  <section class="hub-card">
    <div class="mb-4 flex items-center justify-between gap-2">
      <h2 class="font-display text-lg font-semibold text-[var(--color-text)]">Sent invites</h2>
      <%= link_to "Invite child", new_invitation_path, class: "hub-btn hub-btn-primary hub-btn-sm" %>
    </div>
    <% if @sent_invitations.any? %>
      <ul class="space-y-2 text-sm">
        <% @sent_invitations.each do |invite| %>
          <li class="flex flex-wrap items-center justify-between gap-2 rounded-2xl border border-[var(--color-border)] px-4 py-3">
            <span><strong><%= invite.child_name %></strong> - <%= invite.email %></span>
            <% status = invite.accepted_at.present? ? "Accepted" : "Pending" %>
            <span class="text-xs text-[var(--color-text-muted)]"><%= status %> · sent <%= invite.created_at.to_date %></span>
            <div class="ml-3 flex items-center gap-2">
              <% if invite.accepted_at.blank? %>
                <%= link_to "Edit", edit_invitation_path(invite), class: "hub-btn hub-btn-ghost hub-btn-sm" %>
              <% end %>
              <% if invite.accepted_at.blank? && !invite.expired? %>
                <%= button_to "Resend", resend_invitation_path(invite), method: :post, class: "hub-btn hub-btn-ghost hub-btn-sm" %>
              <% end %>
              <%= button_to "Delete", invitation_path(invite),
                  method: :delete,
                  form: { data: { turbo_confirm: "Delete invite for #{invite.email}?" } },
                  class: "hub-btn hub-btn-ghost hub-btn-sm" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-[var(--color-text-muted)]">No invites sent yet.</p>
    <% end %>
  </section>
</div>
