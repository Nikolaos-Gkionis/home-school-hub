<% content_for :title, "Edit invite — HomeSchool Hub" %>

<div class="mx-auto max-w-md space-y-6 py-2">
  <%= render "shared/hub_page_header",
      kicker: "Family",
      title: "Edit invite",
      description: "Update child details before they accept the invitation." %>

  <%= form_with model: @invitation, url: invitation_path(@invitation), method: :patch, class: "space-y-4" do |f| %>
    <% if @invitation.errors.any? %>
      <ul class="list-inside list-disc text-sm text-[var(--color-danger)]">
        <% @invitation.errors.full_messages.each do |m| %>
          <li><%= m %></li>
        <% end %>
      </ul>
    <% end %>

    <div>
      <%= f.label :child_name, "Child name", class: "hub-label" %>
      <%= f.text_field :child_name, required: true, class: "hub-input" %>
    </div>

    <div>
      <%= f.label :email, class: "hub-label" %>
      <%= f.email_field :email, required: true, class: "hub-input" %>
    </div>

    <div>
      <%= f.label :year_group_key, "School year", class: "hub-label" %>
      <%= f.select :year_group_key,
          Curriculum::YearGroups.all_year_keys.map { |k| [ Curriculum::YearGroups.label_for_year(k), k ] },
          {},
          class: "hub-select" %>
    </div>

    <div class="flex items-center gap-2">
      <%= f.submit "Save invite", class: "hub-btn hub-btn-primary" %>
      <%= link_to "Cancel", parent_family_path, class: "hub-btn hub-btn-ghost" %>
    </div>
  <% end %>
</div>
