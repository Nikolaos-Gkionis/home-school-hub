<% content_for :title, "HomeSchool Hub — Oak curriculum, your hub" %>

<div class="space-y-8">
  <header class="space-y-3">
    <p class="font-display text-sm font-semibold text-[var(--color-accent)]">Learn together</p>
    <h1 class="font-display text-4xl font-semibold leading-tight text-[var(--color-text)] sm:text-5xl">A colourful hub for home learning</h1>
    <p class="text-lg text-[var(--color-text-muted)]">
      HomeSchool Hub brings <strong>Oak National Academy</strong> lessons into a playful space for families.
      Parents plan the year month by month. Children see this month’s work, quizzes, and progress.
    </p>
  </header>

  <ol class="hub-card space-y-5 p-6">
    <li class="flex gap-3">
      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent)] font-display text-lg font-semibold text-[var(--color-on-accent)]">1</span>
      <div>
        <p class="font-semibold text-[var(--color-text)]">Create a parent account</p>
        <p class="text-sm text-[var(--color-text-muted)]">Invite your child, pick their school year, then shape a monthly plan.</p>
      </div>
    </li>
    <li class="flex gap-3">
      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent-2)] font-display text-lg font-semibold text-white">2</span>
      <div>
        <p class="font-semibold text-[var(--color-text)]">Sync Oak lessons</p>
        <p class="text-sm text-[var(--color-text-muted)]">Set <code class="rounded-md bg-[var(--color-hover)] px-1 text-xs">OAK_API_TOKEN</code> and run <code class="rounded-md bg-[var(--color-hover)] px-1 text-xs">bin/rails curriculum:oak_sync</code>.</p>
      </div>
    </li>
    <li class="flex gap-3">
      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--subject-maths)] font-display text-lg font-semibold text-white">3</span>
      <div>
        <p class="font-semibold text-[var(--color-text)]">Plan months, then learn</p>
        <p class="text-sm text-[var(--color-text-muted)]">Assign Oak units to September–July. Children unlock this month’s work as they go.</p>
      </div>
    </li>
    <li class="flex gap-3">
      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--color-success)] font-display text-lg font-semibold text-white">4</span>
      <div>
        <p class="font-semibold text-[var(--color-text)]">Watch progress</p>
        <p class="text-sm text-[var(--color-text-muted)]">Insights shows completions, quiz success, and time on lessons.</p>
      </div>
    </li>
  </ol>

  <div class="flex flex-wrap gap-3">
    <%= link_to "Sign up", new_user_registration_path, class: "hub-btn hub-btn-primary" %>
    <%= link_to "Sign in", new_user_session_path, class: "hub-btn hub-btn-secondary" %>
  </div>

  <p class="text-xs leading-relaxed text-[var(--color-text-muted)]">
    Oak’s API is free and OGL-aligned. Using it is subject to Oak’s <%= link_to "terms", "https://open-api.thenational.academy/docs/about-oaks-api/terms-and-conditions", class: "text-[var(--color-accent)] underline", target: "_blank", rel: "noopener noreferrer" %>;
    they may collect usage data to understand reach and impact, as described in their <%= link_to "API overview", "https://open-api.thenational.academy/docs/about-oaks-api/api-overview", class: "text-[var(--color-accent)] underline", target: "_blank", rel: "noopener noreferrer" %>.
    HomeSchool Hub is not affiliated with Oak National Academy.
  </p>
</div>
