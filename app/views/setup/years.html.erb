<% content_for :title, "Step 1 — School years — HomeSchool Hub" %>

<div class="mx-auto max-w-lg space-y-6 py-2">
  <%= render "shared/hub_page_header",
      kicker: "Step 1 of 2",
      title: "Choose school years",
      description: "Pick every year you need. Next you’ll choose subjects for each year — like Oak’s unit cards, but in your colours." %>

  <%= form_with url: setup_years_path, method: :post, class: "space-y-6", data: { turbo: true } do %>
    <fieldset class="space-y-4">
      <legend class="text-xs font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">School years</legend>
      <% @phases.each do |phase| %>
        <%= render layout: "shared/hub_card", locals: { title: phase[:label] } do %>
          <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
            <% phase[:years].each do |y| %>
              <label class="flex min-h-11 cursor-pointer items-center gap-2 rounded-xl px-2 py-2 text-sm ring-1 ring-[var(--color-border)]/50 hover:bg-[var(--color-hover)]">
                <%= check_box_tag "year_group_keys[]", y[:key], false,
                    class: "rounded border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-accent)]" %>
                <span><%= y[:label] %></span>
              </label>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </fieldset>

    <%= submit_tag "Continue to subjects", class: "hub-btn hub-btn-primary w-full" %>
  <% end %>
</div>
