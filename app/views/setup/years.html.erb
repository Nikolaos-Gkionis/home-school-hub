<% content_for :title, "Step 1 — School years — HomeSchool Hub" %>

<div class="mx-auto max-w-lg space-y-6 py-2">
  <div>
    <p class="text-xs font-semibold uppercase tracking-wide text-[var(--color-accent)]">Step 1 of 2</p>
    <h1 class="font-display text-xl font-bold text-[var(--color-text)] sm:text-2xl">Choose school years</h1>
    <p class="mt-2 text-sm text-[var(--color-text-muted)]">
      Pick every year you need. Next you’ll choose subjects for each year — like Oak’s unit cards, but in your colours.
    </p>
  </div>

  <%= form_with url: setup_years_path, method: :post, class: "space-y-6", data: { turbo: true } do %>
    <fieldset class="space-y-4">
      <legend class="text-xs font-semibold uppercase tracking-wide text-[var(--color-text-muted)]">School years</legend>
      <% @phases.each do |phase| %>
        <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]/60 p-4 shadow-sm">
          <p class="mb-3 text-xs font-semibold text-[var(--color-text)]"><%= phase[:label] %></p>
          <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
            <% phase[:years].each do |y| %>
              <label class="flex cursor-pointer items-center gap-2 rounded-lg px-2 py-2 text-xs ring-1 ring-[var(--color-border)]/50 hover:bg-white/5">
                <%= check_box_tag "year_group_keys[]", y[:key], false,
                    class: "rounded border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-accent)]" %>
                <span><%= y[:label] %></span>
              </label>
            <% end %>
          </div>
        </div>
      <% end %>
    </fieldset>

    <%= submit_tag "Continue to subjects",
        class: "w-full cursor-pointer rounded-xl bg-[var(--color-accent)] px-4 py-3 text-sm font-semibold text-[var(--color-bg)] shadow-md hover:brightness-110" %>
  <% end %>
</div>
