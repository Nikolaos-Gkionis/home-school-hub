<% content_for :title, "Step 2 — Subjects — HomeSchool Hub" %>

<div class="mx-auto max-w-2xl space-y-6 py-2">
  <%= render "shared/hub_page_header",
      kicker: "Step 2 of 2",
      title: "Choose subjects per year",
      description: "Tick the subjects you want for each year. Leave all ticked for everything in that year. You can change this later in the sidebar." %>

  <%= form_with url: setup_subjects_path, method: :post, class: "space-y-6", data: { turbo: true } do %>
    <% @learners.each do |lr| %>
      <%= render layout: "shared/hub_card", locals: { title: "#{lr.display_name} (#{Curriculum::YearGroups.label_for_year(lr.year_group_key)})" } do %>
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          <% @subject_options.each do |subj| %>
            <% checked = lr.preferred_subjects.nil? || Array(lr.preferred_subjects).include?(subj) %>
            <label class="flex min-h-11 cursor-pointer items-center gap-2 rounded-xl px-2 py-2 text-sm ring-1 ring-[var(--color-border)]/40 hover:bg-[var(--color-hover)]">
              <%= check_box_tag "preferred_subjects[#{lr.id}][]", subj, checked,
                  class: "rounded border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-accent)]" %>
              <span><%= subj %></span>
            </label>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <%= submit_tag "Finish setup", class: "hub-btn hub-btn-primary w-full" %>
  <% end %>
</div>
